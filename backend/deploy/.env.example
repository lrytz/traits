# Copy to `.env` on the server next to Dockerfile + docker-compose.yml.
# NEVER overwritten by deploy.sh — hand-managed. `chmod 600 .env`.

# --- Required: environment marker -------------------------------------------
# `prod` makes secret loading fail-closed (no in-source dev defaults) and marks
# the session cookie Secure (it's served over HTTPS via nginx).
TRAITS_ENV=prod

# --- Required: session cookie HMAC ------------------------------------------
# Long random secret; rotating it invalidates every active editor session.
# Generate with: openssl rand -hex 32
TRAITS_SESSION_SECRET=

# --- Required: editor password ----------------------------------------------
# Gates create/edit/delete (and the API writes). Reads are public, so this is
# all that protects the curated data — pick a real value, NOT the dev
# "let-me-in". Share only with trusted reviewers. Generate: openssl rand -hex 16
TRAITS_EDITOR_PASSWORD=

# --- Optional (defaults shown) ----------------------------------------------
# TRAITS_HTTP_PORT=8080      # container-internal port; compose maps host :8090 → 8080
# TRAITS_DB_POOL_SIZE=4
